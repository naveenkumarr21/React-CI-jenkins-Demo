pipeline {
    agent any

    tools {
        nodejs 'NodeJS_20'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/USERNAME/react-jenkins-demo.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Deploy To Github Pages') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                    git config --global user.email "jenkins@example.com"
                    git config --global user.name "Jenkins"

                    git remote set-url origin https://${GITHUB_TOKEN}@github.com/USERNAME/react-jenkins-demo.git

                    npm run deploy
                    '''
                }
            }
        }
    }
}
